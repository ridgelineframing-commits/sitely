<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:layout_marginTop="4dp" android:padding="10dp">
    <TextView android:id="@+id/task_firm" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="?" android:textSize="13sp"
        android:textStyle="bold" android:textColor="#7A8088" android:paddingRight="10dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/task_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#E6E3DC" android:textSize="14sp"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/task_sub" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#8A9098" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" android:paddingTop="1dp" />
    </LinearLayout>
</LinearLayout>
